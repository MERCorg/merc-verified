import Lean

/-!
# Export check for `MercLib` and `MercVerified` (human-vetted)

`EXPORTS.md` (checked in, human-vetted) is the explicit list of everything a downstream import
of `MercLib` or `MercVerified` can see. This script loads each library exactly as an importing
`module` sees it (`OLeanLevel.exported`: only modules reached from the library root through a chain of
`public import`s, and only their non-private declarations) and fails if the actual exports differ from that list.

* **Spec modules** (no `Proofs` component in the module name) are human-vetted; what they export
  is the API.
* **Generated modules** (Aeneas output in `MercVerified/Code/`, recognised by its header) are
  checked against the Rust sources by regeneration; `EXPORTS.md` lists only their size.
* **Proof modules** (`…/Proofs/…`) are machine-generated. They should export only the headline
  theorems named in the comparator configs (`comparator.json`, `comparator_MercVerified.json`);
  every other declaration (proof-internal structures included) is `private`, and sibling proof
  files reach it with `import all`. Any other export of a proof module is listed in `EXPORTS.md`
  with the tag *not a headline*, so each one is approved explicitly in review.

So a machine-generated proof that starts exporting something new fails this check until a human
accepts the `EXPORTS.md` diff.

Usage, from the repository root:
* `lake env lean --run scripts/CheckExports.lean`: check against `EXPORTS.md`; also fails if a
  headline of a comparator config is not exported.
* `lake env lean --run scripts/CheckExports.lean --write`: regenerate `EXPORTS.md` (review the
  diff before committing).
-/

open Lean

def manifestPath : System.FilePath := "EXPORTS.md"

/-- The libraries checked, with their comparator configs. -/
def libraries : List (Name × String) :=
  [(`MercLib, "comparator.json"), (`MercVerified, "comparator_MercVerified.json")]

/-- The headline theorems: the `theorem_names` of a comparator config. -/
def headlines (config : String) : IO NameSet := do
  let json ← IO.ofExcept (Json.parse (← IO.FS.readFile config))
  let names ← IO.ofExcept (json.getObjValAs? (Array String) "theorem_names")
  return names.foldl (fun s n => s.insert n.toName) {}

def isProofModule (m : Name) : Bool := m.components.contains `Proofs

/-- Modules generated by Aeneas (`MercVerified/Code/`, except the hand-written `*External*`
    stubs): checked against the Rust sources by regeneration, so only their size is listed. -/
def isGeneratedModule (m : Name) : IO Bool := do
  let path : System.FilePath := (m.components.map toString |> "/".intercalate) ++ ".lean"
  unless ← path.pathExists do return false
  return (← IO.FS.readFile path).startsWith "-- THIS FILE WAS AUTOMATICALLY GENERATED BY AENEAS"

/-- Declarations generated by Lean for another declaration (recursors, equation lemmas, matchers,
    structure projections, …). They are reported through their parent. -/
def isGenerated (env : Environment) (n : Name) (ci : ConstantInfo) : Bool :=
  n.isInternalDetail || isAuxRecursor env n || isNoConfusion env n || ci.isCtor || (match ci with | .recInfo _ => true | _ => false) ||
    (env.getProjectionFnInfo? n).isSome ||
    (match n with
     | .str p s =>
       (env.find? p).isSome &&
         (s.startsWith "eq_" || s.startsWith "match_" || s.startsWith "proof_" ||
          ["injEq", "inj", "sizeOf_spec", "ctorIdx", "eq_def", "ext", "ext_iff", "mk", "congr_simp"].contains s)
     | _ => false)

def kind : ConstantInfo → String
  | .thmInfo _ => "theorem"
  | .defnInfo _ => "def"
  | .opaqueInfo _ => "opaque"
  | .axiomInfo _ => "axiom"
  | .inductInfo _ => "inductive"
  | .ctorInfo _ => "constructor"
  | .recInfo _ => "recursor"
  | .quotInfo _ => "quot"

def main (args : List String) : IO UInt32 := do
  initSearchPath (← findSysroot)
  let mut out := "# Exports of `MercLib` and `MercVerified`\n\n" ++
    "Human-vetted. Everything a downstream import can see, by module; checked by\n" ++
    "`scripts/CheckExports.lean` and regenerated with its `--write` flag. In proof modules,\n" ++
    "every export other than a headline theorem of the comparator configs is tagged\n" ++
    "*not a headline*. Modules generated by Aeneas are listed only by size; regenerating them\n" ++
    "from the Rust sources checks their contents.\n"
  let mut ok := true
  for (lib, config) in libraries do
    let env ← importModules #[{ module := lib }] {} (level := .exported)
    let allowed ← headlines config
    let mut byModule : Std.HashMap Name (Array (String × Name)) := {}
    let mut extra := 0
    for (n, ci) in env.constants.toList do
      let some idx := env.getModuleIdxFor? n | continue
      let m := env.header.moduleNames[idx.toNat]!
      unless lib.isPrefixOf m do continue
      -- only modules reached through `public import`s all the way are visible downstream
      unless env.header.modules[idx.toNat]!.isExported do continue
      if isPrivateName n || isGenerated env n ci then continue
      byModule := byModule.insert m ((byModule.getD m #[]).push (kind ci, n))
      if isProofModule m && !allowed.contains n then extra := extra + 1
    let modules := byModule.toArray.qsort (fun a b => a.1.toString < b.1.toString)
    for (m, decls) in modules do
      if ← isGeneratedModule m then
        out := out ++ s!"\n## `{m}` (generated by Aeneas)\n\n* {decls.size} declarations\n"
        continue
      out := out ++ s!"\n## `{m}`{if isProofModule m then " (proofs)" else ""}\n\n"
      for (k, n) in decls.qsort (fun a b => a.2.toString < b.2.toString) do
        let tag := if isProofModule m && !allowed.contains n then " *not a headline*" else ""
        out := out ++ s!"* {k} `{n}`{tag}\n"
    for n in allowed.toList do
      unless env.contains n do
        IO.eprintln s!"error: headline `{n}` of {config} is not exported"
        ok := false
    IO.println s!"{lib}: {modules.size} modules, {extra} non-headline exports from proof modules"
  if args.contains "--write" then
    IO.FS.writeFile manifestPath out
  else if (← manifestPath.pathExists) && (← IO.FS.readFile manifestPath) == out then
    pure ()
  else
    IO.eprintln s!"error: {manifestPath} differs from the actual exports; rerun with --write and review the diff"
    ok := false
  return if ok then 0 else 1
